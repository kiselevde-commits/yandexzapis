# Пример файла .env для локальной разработки
# Скопируйте этот файл в .env и заполните своими значениями

# Токен бота (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# URL базы данных PostgreSQL (для Render заполняется автоматически)
# Формат: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/bot_db

# Путь к файлу базы данных SQLite (для локальной разработки без PostgreSQL)
DB_PATH=schedule.db

# Путь к JSON-файлу с ID динамических администраторов
ADMIN_IDS_FILE=admin_ids.json

# Папка для постоянных данных (на Render не используется)
# DATA_DIR=/data